# data/* not data/: docker does not descend into an excluded directory, so a
# bare `data` leaves the negations below unreachable and the corpus absent from
# the image. Verified by build, both ways -- see test_docker_stack_contract.py.
data/*
!data/corpus.jsonl
!data/corpora.json
