# HuggingFace Hub token — required for downloading gated models (e.g. rerankers, embedders)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# Java (required for BM25 indexing via pyserini — must point to an arm64 JDK on Apple Silicon)
# brew install openjdk  →  /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home
JAVA_HOME=

# OpenMP (macOS Apple Silicon only — prevents segfault when PyTorch and FAISS are loaded together)
# Required only if faiss-cpu was installed via pip instead of conda.
# conda install -c conda-forge faiss-cpu is the preferred install method on macOS.
KMP_DUPLICATE_LIB_OK=TRUE

# LLM provider (used by the chat pipeline)
# Provider name: openai | anthropic | azure | google | cohere | ollama_chat
GEN_AI_MODEL_PROVIDER=openai
# Model name as the provider knows it
GEN_AI_MODEL_VERSION=gpt-4o-mini
# API key – omit for local endpoints (Ollama, LiteLLM proxy without auth)
GEN_AI_API_KEY=
# Override the base URL, e.g. http://localhost:11434/v1 for Ollama
GEN_AI_API_BASE=
# Context window size (tokens)
GEN_AI_MAX_INPUT_TOKENS=8192

# Optional nearest-canonical-example request router. Empty keeps it disabled.
# Directory containing index.npz built by `python -m src.model.pre_training.intents.cli build`.
AGENTIC_SEARCH_INTENT_INDEX_PATH=
# Record predictions for requests reaching similarity, then continue to fallback.
AGENTIC_SEARCH_INTENT_SHADOW_MODE=false
# Minimum cosine-similarity gap between the top and runner-up route.
# This margin is the only model abstention gate; confidence is diagnostic.
AGENTIC_SEARCH_INTENT_MIN_ROUTE_MARGIN=0.010
# Minimum cosine similarity for diagnostic module labels; does not change routing.
AGENTIC_SEARCH_INTENT_MIN_MODULE_SCORE=0.8215
# Neighbors averaged per route (positive integer), selected jointly with margin.
# See docs/training-and-evaluation.md for the tuning procedure.
AGENTIC_SEARCH_INTENT_TOP_K=8

# Ask which route was meant when the router has no signal, instead of guessing.
AGENTIC_SEARCH_ROUTE_CLARIFICATION=true

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI
SERP_API_KEY=

# AnySearch (optional REST provider and native capability tools)
ANYSEARCH_API_KEY=
ANYSEARCH_API_BASE_URL=https://api.anysearch.com
# Register search/discovery/extract/batch operations in the tool registry.
AGENTIC_SEARCH_ANYSEARCH_ENABLED=false
# MCP_WEB_SEARCH_PROVIDER=anysearch selects AnySearch for MCP general web search.

# Search Agent (local MPS model via run_web_stack.sh)
# Set SEARCH_AGENT_MODEL to enable the "Search Agent (Local Model)" mode in the UI.
# Omit to disable that mode (all other modes still work without it).
# Model recommendation by available RAM (Apple Silicon unified memory):
#   8 GB  → Qwen/Qwen2.5-0.5B-Instruct  (~1 GB weights)
#   16 GB → Qwen/Qwen2.5-1.5B-Instruct  (~3 GB weights, better quality)
SEARCH_AGENT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SEARCH_AGENT_DEVICE=mps
# Optional: ngrok URL from colab-vllm.py — when set, uses remote vLLM instead of local model
SEARCH_AGENT_VLLM_URL=

# run_web_stack.sh port overrides (optional — defaults shown)
SERP_PORT=8000
WEB_PORT=7860

# Server bind addresses (optional — defaults shown)
GOOGLE_SEARCH_HOST=0.0.0.0
GOOGLE_SEARCH_PORT=8001
SERP_SEARCH_HOST=0.0.0.0
SERP_SEARCH_PORT=8001
RERANK_SERVER_HOST=0.0.0.0
RERANK_SERVER_PORT=6980
RETRIEVAL_SERVER_HOST=0.0.0.0
RETRIEVAL_SERVER_PORT=8001

# Dev-only: allow the web UI to override the retrieval URL via the request body.
# Off by default — the backend resolves the retrieval URL from the selected
# Source, so a client cannot point the server at an arbitrary URL (SSRF). Set to
# true only for local debugging (reveals the raw URL box in the UI via ?dev=1).
AGENTIC_SEARCH_ALLOW_CLIENT_RETRIEVAL_URL=false

# Query Transformations — all default to false (disabled)
# Enable any combination to activate multi-query RAG-Fusion retrieval.
# QT_MAX_VARIANTS caps the total number of retrieval variants (default 5).
# When any QT_* flag is true, GEN_AI_* env vars must also be set.
QT_DECOMPOSE=false
QT_HYDE=false
QT_STEP_BACK=false
QT_KEYWORDS=false
QT_CONSTRUCT_FILTERS=false
QT_MAX_VARIANTS=5

# Application authentication — see docs/workload-identity.md.
# Production requires a unique signing secret and forbids development admin bypass.
AGENTIC_SEARCH_ENVIRONMENT=development
AGENTIC_SEARCH_DEV_ADMIN=false
# AGENTIC_SEARCH_AUTH_SECRET=<load a securely generated secret from your secret store>
# Optional workload federation: configure all four settings together.
# AGENTIC_SEARCH_JWT_PUBLIC_KEY_URL=https://your-issuer.example/keys
# AGENTIC_SEARCH_WORKLOAD_ISSUER=https://your-issuer.example
# AGENTIC_SEARCH_WORKLOAD_AUDIENCE=https://search.example.com
# AGENTIC_SEARCH_WORKLOAD_SUBJECTS={"trusted-subject":{"user_id":"provisioned-user"}}

# Optional ElastiCache IAM authentication; AWS credentials come from the SDK chain.
USE_REDIS_IAM_AUTH=false
# REDIS_IAM_USER=search-worker
# REDIS_IAM_CACHE_NAME=your-cache-name
# REDIS_IAM_SERVERLESS=false
# AWS_REGION_NAME=us-east-1
